<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto; padding: 20px; }
        .product-detail { border: 1px solid #ddd; border-radius: 8px; padding: 24px; }
        .product-detail h1 { margin-top: 0; }
        .product-detail p { font-size: 1rem; color: #444; }
        .price { font-size: 1.4rem; font-weight: bold; color: #000; }
        img { width: 100%; height: 300px; object-fit: cover; border-radius: 8px; margin-bottom: 16px; }
        .btn { display: inline-block; margin-top: 16px; padding: 10px 20px; background: #333; color: white; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; font-size: 1rem; }
        .btn-back { background: #777; margin-right: 10px; }
    </style>
</head>
<body>
    <div class="product-detail">
        {{#if product.thumbnails.length}}
        <img src="{{product.thumbnails.[0]}}" alt="{{product.title}}">
        {{/if}}
        <h1>{{product.title}}</h1>
        <p><strong>Descripción:</strong> {{product.description}}</p>
        <p><strong>Categoría:</strong> {{product.category}}</p>
        <p><strong>Código:</strong> {{product.code}}</p>
        <p class="price">Precio: ${{product.price}}</p>
        <p><strong>Stock:</strong> {{product.stock}}</p>
        <p><strong>Estado:</strong> {{#if product.status}}Disponible{{else}}No disponible{{/if}}</p>
    </div>

    <div style="margin-top: 20px;">
        <a href="/products" class="btn btn-back">← Volver</a>
        <button class="btn" onclick="addToCart('{{product._id}}')">Agregar al carrito</button>
    </div>

    <script>
        async function addToCart(productId) {
            let cartId = localStorage.getItem('cartId');
            if (!cartId) {
                const res = await fetch('/api/carts', { method: 'POST' });
                const data = await res.json();
                cartId = data.payload._id;
                localStorage.setItem('cartId', cartId);
            }
            const res = await fetch(`/api/carts/${cartId}/product/${productId}`, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'success') {
                alert('Producto agregado al carrito ✓');
            } else {
                alert('Error al agregar al carrito');
            }
        }
    </script>
</body>
</html>